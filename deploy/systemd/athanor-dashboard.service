[Unit]
Description=Athanor Alpha — Streamlit Dashboard (port 8501)
Documentation=file:///home/athanor/athanor-alpha/docs/OPERATOR_QUICKSTART.md
After=network.target

[Service]
Type=simple
User=athanor
Group=athanor
WorkingDirectory=/home/athanor/athanor-alpha
EnvironmentFile=/home/athanor/athanor-alpha/.env
ExecStart=/home/athanor/athanor-alpha/.venv/bin/streamlit run dashboard/app.py \
    --server.port 8501 \
    --server.address 127.0.0.1 \
    --server.headless true \
    --server.fileWatcherType none \
    --browser.gatherUsageStats false
Restart=on-failure
RestartSec=15s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=athanor-dashboard

MemoryMax=1G
CPUQuota=80%
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
