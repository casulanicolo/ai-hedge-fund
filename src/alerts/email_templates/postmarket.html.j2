<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Athanor EOD Digest {{ date }}</title>
</head>
<body style="margin:0;padding:24px 0;background:#f0f2f5;font-family:-apple-system,'Segoe UI',Arial,sans-serif;">
<table width="100%" cellpadding="0" cellspacing="0" style="background:#f0f2f5;">
<tr><td align="center">
<table width="640" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:8px;overflow:hidden;box-shadow:0 2px 12px rgba(0,0,0,.10);max-width:640px;">

  {# ── HEADER ── #}
  <tr>
    <td style="background:#0d1b2a;padding:22px 32px 18px;">
      <p style="margin:0;color:#7eb8e8;font-size:10px;letter-spacing:2px;text-transform:uppercase;">Athanor Alpha · EOD Digest</p>
      <h1 style="margin:4px 0 0;color:#ffffff;font-size:20px;font-weight:700;letter-spacing:.3px;">{{ date }}</h1>
      <p style="margin:4px 0 0;color:#a0b4c8;font-size:12px;">Generated {{ generated_at }} UTC</p>
    </td>
  </tr>

  {# ── P&L SUMMARY BAR ── #}
  <tr>
    <td style="background:#1a3a5c;padding:12px 32px;">
      <table width="100%" cellpadding="0" cellspacing="0">
        <tr>
          <td style="text-align:center;border-right:1px solid #2a5080;padding:6px 10px;">
            <div style="font-size:18px;font-weight:700;color:{{ summary.pl_color }};">{{ summary.pl_str }}</div>
            <div style="font-size:10px;color:#7eb8e8;text-transform:uppercase;letter-spacing:1px;">P&L Today</div>
          </td>
          <td style="text-align:center;border-right:1px solid #2a5080;padding:6px 10px;">
            <div style="font-size:16px;font-weight:700;color:{{ summary.alpha_color }};">{{ summary.alpha_str }}</div>
            <div style="font-size:10px;color:#7eb8e8;text-transform:uppercase;letter-spacing:1px;">vs SPY</div>
          </td>
          <td style="text-align:center;border-right:1px solid #2a5080;padding:6px 10px;">
            <div style="font-size:18px;font-weight:700;color:#4caf91;">{{ summary.fills }}</div>
            <div style="font-size:10px;color:#7eb8e8;text-transform:uppercase;letter-spacing:1px;">Fills</div>
          </td>
          <td style="text-align:center;border-right:1px solid #2a5080;padding:6px 10px;">
            <div style="font-size:18px;font-weight:700;color:#e8c43a;">{{ summary.exits }}</div>
            <div style="font-size:10px;color:#7eb8e8;text-transform:uppercase;letter-spacing:1px;">Exits</div>
          </td>
          <td style="text-align:center;padding:6px 10px;">
            <div style="font-size:18px;font-weight:700;color:{% if summary.rejects > 0 %}#e07070{% else %}#a0b4c8{% endif %};">{{ summary.rejects }}</div>
            <div style="font-size:10px;color:#7eb8e8;text-transform:uppercase;letter-spacing:1px;">Rejects</div>
          </td>
        </tr>
      </table>
    </td>
  </tr>

  {# ── SECTION 1: P&L BREAKDOWN ── #}
  <tr>
    <td style="padding:20px 32px 0;">
      <p style="margin:0 0 10px;font-size:11px;font-weight:700;color:#7f8c8d;text-transform:uppercase;letter-spacing:1.5px;border-bottom:1px solid #ecf0f1;padding-bottom:6px;">1 · P&L Breakdown</p>
      <table width="100%" cellpadding="0" cellspacing="0" style="font-size:13px;">
        <tr>
          <td style="padding:5px 0;color:#666;width:50%;">Realized P&L</td>
          <td style="padding:5px 0;font-weight:700;color:{{ summary.realized_color }};">{{ summary.realized_str }}</td>
        </tr>
        <tr>
          <td style="padding:5px 0;color:#666;">Unrealized P&L</td>
          <td style="padding:5px 0;font-weight:600;color:{{ summary.unrealized_color }};">{{ summary.unrealized_str }}</td>
        </tr>
        <tr>
          <td style="padding:5px 0;color:#666;">Equity EOD</td>
          <td style="padding:5px 0;font-weight:600;color:#333;">{{ summary.equity_eod }}</td>
        </tr>
        <tr>
          <td style="padding:5px 0;color:#666;">Max intraday drawdown</td>
          <td style="padding:5px 0;font-weight:600;color:#e07070;">{{ summary.max_dd_str }}</td>
        </tr>
        <tr>
          <td style="padding:5px 0;color:#666;">Peak exposure</td>
          <td style="padding:5px 0;color:#555;">{{ summary.peak_exposure }}</td>
        </tr>
      </table>
    </td>
  </tr>

  {# ── SECTION 2: EXECUTED ORDERS ── #}
  <tr>
    <td style="padding:20px 32px 0;">
      <p style="margin:0 0 10px;font-size:11px;font-weight:700;color:#7f8c8d;text-transform:uppercase;letter-spacing:1.5px;border-bottom:1px solid #ecf0f1;padding-bottom:6px;">2 · Today's Executed Orders</p>
      {% if executed_orders %}
      <table width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;font-size:12px;">
        <thead>
          <tr style="background:#f0f4f8;">
            <th style="padding:7px 6px;text-align:left;font-weight:600;color:#555;">Time</th>
            <th style="padding:7px 6px;text-align:left;font-weight:600;color:#555;">Ticker</th>
            <th style="padding:7px 6px;text-align:left;font-weight:600;color:#555;">Action</th>
            <th style="padding:7px 6px;text-align:right;font-weight:600;color:#555;">Qty</th>
            <th style="padding:7px 6px;text-align:right;font-weight:600;color:#555;">Fill Price</th>
            <th style="padding:7px 6px;text-align:left;font-weight:600;color:#555;">Source</th>
            <th style="padding:7px 6px;text-align:left;font-weight:600;color:#555;">Status</th>
          </tr>
        </thead>
        <tbody>
          {% for o in executed_orders %}
          <tr style="border-bottom:1px solid #f0f0f0;">
            <td style="padding:7px 6px;color:#777;font-size:11px;">{{ o.time }}</td>
            <td style="padding:7px 6px;font-weight:700;color:#0d1b2a;">{{ o.ticker }}</td>
            <td style="padding:7px 6px;">
              <span style="background:{{ o.action_bg }};color:{{ o.action_fg }};padding:2px 6px;border-radius:3px;font-size:11px;font-weight:700;">{{ o.action }}</span>
            </td>
            <td style="padding:7px 6px;text-align:right;color:#333;">{{ o.qty }}</td>
            <td style="padding:7px 6px;text-align:right;color:#333;">{{ o.fill_price }}</td>
            <td style="padding:7px 6px;font-size:11px;color:#666;">{{ o.source }}</td>
            <td style="padding:7px 6px;">
              <span style="color:{% if o.status == 'FILLED' %}#27ae60{% elif o.status == 'REJECTED' %}#c0392b{% else %}#e8a83a{% endif %};font-weight:600;font-size:11px;">{{ o.status }}</span>
            </td>
          </tr>
          {% if o.rejection_reason %}
          <tr>
            <td colspan="7" style="padding:2px 6px 7px 14px;font-size:11px;color:#c0392b;font-style:italic;">
              ↳ Rejected: {{ o.rejection_reason }}
            </td>
          </tr>
          {% endif %}
          {% endfor %}
        </tbody>
      </table>
      {% else %}
      <p style="margin:0;font-size:13px;color:#95a5a6;font-style:italic;">No orders executed today.</p>
      {% endif %}
    </td>
  </tr>

  {# ── SECTION 3: MONITOR TICKS ── #}
  <tr>
    <td style="padding:20px 32px 0;">
      <p style="margin:0 0 10px;font-size:11px;font-weight:700;color:#7f8c8d;text-transform:uppercase;letter-spacing:1.5px;border-bottom:1px solid #ecf0f1;padding-bottom:6px;">3 · Intraday Monitor Decisions</p>
      <table width="100%" cellpadding="0" cellspacing="0" style="font-size:13px;">
        <tr>
          <td style="padding:5px 0;color:#666;width:50%;">Total evaluation cycles</td>
          <td style="padding:5px 0;font-weight:600;color:#333;">{{ monitor.total_ticks }}</td>
        </tr>
        <tr>
          <td style="padding:5px 0;color:#666;">Actions taken</td>
          <td style="padding:5px 0;font-weight:700;color:{% if monitor.actions_taken > 0 %}#e8a83a{% else %}#27ae60{% endif %};">{{ monitor.actions_taken }}</td>
        </tr>
      </table>
      {% if monitor.rules_summary %}
      <table width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;font-size:12px;margin-top:8px;">
        <thead>
          <tr style="background:#f0f4f8;">
            <th style="padding:6px 8px;text-align:left;font-weight:600;color:#555;">Rule</th>
            <th style="padding:6px 8px;text-align:right;font-weight:600;color:#555;">Triggered</th>
          </tr>
        </thead>
        <tbody>
          {% for rule, count in monitor.rules_summary %}
          {% if count > 0 %}
          <tr style="border-bottom:1px solid #f5f5f5;">
            <td style="padding:5px 8px;color:#444;">{{ rule }}</td>
            <td style="padding:5px 8px;text-align:right;font-weight:{% if rule != 'hold' %}700{% else %}400{% endif %};color:{% if rule != 'hold' %}#e8a83a{% else %}#999{% endif %};">{{ count }}</td>
          </tr>
          {% endif %}
          {% endfor %}
        </tbody>
      </table>
      {% endif %}
    </td>
  </tr>

  {# ── SECTION 4: ACCURACY CHECK ── #}
  <tr>
    <td style="padding:20px 32px 0;">
      <p style="margin:0 0 10px;font-size:11px;font-weight:700;color:#7f8c8d;text-transform:uppercase;letter-spacing:1.5px;border-bottom:1px solid #ecf0f1;padding-bottom:6px;">4 · Agent Accuracy (Last 20 Trades)</p>
      {% if accuracy.top %}
      <table width="100%" cellpadding="0" cellspacing="0" style="font-size:12px;border-collapse:collapse;">
        <tr style="background:#eafaf1;">
          <td colspan="2" style="padding:6px 8px;font-size:11px;font-weight:700;color:#1e8449;text-transform:uppercase;letter-spacing:1px;">Top Performers</td>
        </tr>
        {% for agent, w in accuracy.top %}
        <tr style="border-bottom:1px solid #f5f5f5;">
          <td style="padding:5px 8px;color:#333;">{{ agent }}</td>
          <td style="padding:5px 8px;text-align:right;font-weight:700;color:#1a7a4a;">{{ w }}</td>
        </tr>
        {% endfor %}
        {% if accuracy.bottom %}
        <tr style="background:#fdf2f2;">
          <td colspan="2" style="padding:6px 8px;font-size:11px;font-weight:700;color:#922b21;text-transform:uppercase;letter-spacing:1px;">Underperformers</td>
        </tr>
        {% for agent, w in accuracy.bottom %}
        <tr style="border-bottom:1px solid #f5f5f5;">
          <td style="padding:5px 8px;color:#333;">{{ agent }}</td>
          <td style="padding:5px 8px;text-align:right;font-weight:600;color:#b03030;">{{ w }}</td>
        </tr>
        {% endfor %}
        {% endif %}
      </table>
      {% else %}
      <p style="margin:0;font-size:13px;color:#95a5a6;font-style:italic;">No agent weight data available yet.</p>
      {% endif %}
    </td>
  </tr>

  {# ── SECTION 5: OVERNIGHT POSITIONS ── #}
  <tr>
    <td style="padding:20px 32px 0;">
      <p style="margin:0 0 10px;font-size:11px;font-weight:700;color:#7f8c8d;text-transform:uppercase;letter-spacing:1.5px;border-bottom:1px solid #ecf0f1;padding-bottom:6px;">5 · Positions Carried Overnight</p>
      {% if overnight %}
      <table width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;font-size:12px;">
        <thead>
          <tr style="background:#f0f4f8;">
            <th style="padding:7px 8px;text-align:left;font-weight:600;color:#555;">Ticker</th>
            <th style="padding:7px 8px;text-align:left;font-weight:600;color:#555;">Side</th>
            <th style="padding:7px 8px;text-align:right;font-weight:600;color:#555;">Qty</th>
            <th style="padding:7px 8px;text-align:right;font-weight:600;color:#555;">Unreal P&L</th>
            <th style="padding:7px 8px;text-align:left;font-weight:600;color:#555;">Rationale</th>
          </tr>
        </thead>
        <tbody>
          {% for pos in overnight %}
          <tr style="border-bottom:1px solid #f0f0f0;">
            <td style="padding:7px 8px;font-weight:700;color:#0d1b2a;">{{ pos.ticker }}</td>
            <td style="padding:7px 8px;">
              <span style="background:{% if pos.side == 'long' %}#d4f4e2{% else %}#fde0e0{% endif %};color:{% if pos.side == 'long' %}#1a7a4a{% else %}#b03030{% endif %};padding:2px 7px;border-radius:3px;font-size:11px;font-weight:700;">{{ pos.side | upper }}</span>
            </td>
            <td style="padding:7px 8px;text-align:right;color:#333;">{{ pos.qty }}</td>
            <td style="padding:7px 8px;text-align:right;font-weight:600;color:{{ pos.pl_color }};">{{ pos.pl_str }}</td>
            <td style="padding:7px 8px;font-size:11px;color:#666;">{{ pos.rationale }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      {% else %}
      <p style="margin:0;font-size:13px;color:#27ae60;font-weight:600;">All positions closed — flat overnight.</p>
      {% endif %}
    </td>
  </tr>

  {# ── SECTION 6: ANOMALIES ── #}
  {% if anomalies %}
  <tr>
    <td style="padding:20px 32px 0;">
      <p style="margin:0 0 10px;font-size:11px;font-weight:700;color:#7f8c8d;text-transform:uppercase;letter-spacing:1.5px;border-bottom:1px solid #ecf0f1;padding-bottom:6px;">6 · Anomalies &amp; Warnings</p>
      <div style="background:#fdf2f2;border-left:4px solid #c0392b;padding:12px 16px;border-radius:0 4px 4px 0;">
        {% for a in anomalies %}
        <p style="margin:3px 0;font-size:12px;color:#6b2323;">· {{ a }}</p>
        {% endfor %}
      </div>
    </td>
  </tr>
  {% endif %}

  {# ── FOOTER ── #}
  <tr>
    <td style="background:#0d1b2a;padding:16px 32px;margin-top:24px;">
      <p style="margin:0;color:#a0b4c8;font-size:11px;line-height:1.6;">
        Athanor Alpha · EOD Digest · {{ date }}<br>
        AI-generated summary. Not financial advice. No positions are executed automatically.
      </p>
    </td>
  </tr>

</table>
</td></tr>
</table>
</body>
</html>
