# LLM Provider (scegli uno)
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here

# SEC EDGAR (obbligatorio, identifica le tue richieste)
SEC_EDGAR_USER_AGENT=NomeAzienda nome@email.com

# Email alerts (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tua@gmail.com
SMTP_PASSWORD=your_app_password_here
ALERT_RECIPIENT=tua@email.com

# Alpaca Paper Trading (Fase 2 — required for --live flag)
ALPACA_API_KEY_ID=your_alpaca_key_id_here
ALPACA_API_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets   # must contain "paper" — live URL rejected

# Execution limits
ALPACA_DAILY_ORDER_CAP=20       # max orders submitted per calendar day
PORTFOLIO_SIZE_USD=100000       # paper account size in USD
