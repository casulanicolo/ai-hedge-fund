# ============================================================
# Athanor Alpha — Environment Variables
# Copy to .env and fill in your values before running.
# NEVER commit .env to git.
# ============================================================

# ── LLM Providers (at least one required) ────────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here
GROQ_API_KEY=your_groq_key_here              # optional — fast/cheap inference
DEEPSEEK_API_KEY=your_deepseek_key_here      # optional — alternative provider

# ── SEC EDGAR (required — identifies your requests to SEC) ───
# Format: "CompanyName contact@email.com"
SEC_EDGAR_USER_AGENT=AthanorAlpha your@email.com

# ── Email / SMTP ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tua@gmail.com
SMTP_PASSWORD=your_app_password_here         # Gmail: use App Password (not account password)
ALERT_RECIPIENT=tua@email.com                # where pre/post-market emails are sent

# ── Alpaca Paper Trading (Fase 2) ────────────────────────────
ALPACA_API_KEY_ID=your_alpaca_key_id_here
ALPACA_API_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets  # keep "paper" — live URL is rejected

# ── Execution limits (Fase 2) ─────────────────────────────────
ALPACA_DAILY_ORDER_CAP=20            # max broker orders per calendar day

# ── Portfolio sizing (Fase 3) ─────────────────────────────────
PORTFOLIO_SIZE_USD=10000             # paper account size in USD
RISK_PER_TRADE_PCT=0.005             # risk 0.5% of portfolio per trade
MAX_ACTIVE_TRADES=3                  # max simultaneous open positions

# ── LLM Backtest guard (Fase 5) ──────────────────────────────
# Set to "1" to force deterministic seeded signals (no LLM calls during backtest)
ATHANOR_BACKTEST_MODE=               # leave empty for live mode; set to "1" for backtest

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR

# ── Notes ─────────────────────────────────────────────────────
# - Dashboard (Fase 6): no env vars — reads from DB. Port set via CLI.
# - ML meta-learner (Fase 7): no env vars; model saved to models/
# - Circuit breaker thresholds (Fase 8): hardcoded in src/risk/circuit_breakers.py
# - Audit trail (Fase 8): writes to DB automatically (no config needed)
